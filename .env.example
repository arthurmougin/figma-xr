# Public OAuth client ID (same value as FIGMA_CLIENT_ID on the auth server).
VITE_ID=your_figma_client_id
# Leave empty for local development: Vite proxies /api/figma to port 8787.
# Production example: https://your-auth-host.example/api/figma
VITE_AUTH_API_URL=

# Optional fixed plugin endpoints for a hosted release. Local builds infer Wi-Fi.
# FIGMA_XR_COMPANION_URL=https://your-companion.example/figma-xr/
# FIGMA_XR_RELAY_URL=https://your-relay.example
# FIGMA_XR_DESKTOP_RELAY_URL=https://your-relay.example
